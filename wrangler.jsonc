{
  // Built by @cloudflare/vite-plugin (`pnpm run build:cf`): it writes the deploy
  // config to dist/server/wrangler.json (entry bundle + dist/client assets), and
  // wrangler dev/deploy pick it up through .wrangler/deploy/config.json.
  "name": "schemas",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Serve the prerendered /index.html and /collection/<v>/index.html at `/` and
  // the extension-less /collection/<v>. Their `/` and `/index.html` variants
  // would get native 307s; the generated `_redirects` (applied first) 301s them
  // instead. Caveat: any HTML asset at a *.html URL would also be 307'd, so
  // don't add pages that must be served at a .html URL.
  "assets": { "html_handling": "drop-trailing-slash" }
}
